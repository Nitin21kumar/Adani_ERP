NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/employee_erp
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@12345

# Asset Audit & Verification Portal — separate secret, separate sessions (see README "Asset Audit & Verification Portal")
AUDIT_JWT_ACCESS_SECRET=replace-with-a-long-random-secret-different-from-the-one-above
AUDIT_ACCESS_TOKEN_EXPIRES_IN=12h
SEED_AUDIT_ADMIN_EMAIL=auditadmin@company.com
SEED_AUDIT_ADMIN_PASSWORD=Audit@12345
